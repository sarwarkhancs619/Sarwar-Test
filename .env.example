# Copy this file to .env and fill in real values

# Port the Express server listens on
PORT=3001

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase project credentials — https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Alternative Speech-to-Text APIs ---

# AssemblyAI API Key
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Groq API Key (for fast Whisper transcription)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (for Whisper API)
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Project ID and Credentials
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/google_cloud_credentials.json

# AWS Credentials (for Amazon Transcribe)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region
